            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_11" id="BPMNEdge_SequenceFlow_11" sourceElement="BPMNShape_CallActivity_10" targetElement="BPMNShape_EndEvent_2">
                <di:waypoint x="640.0" xsi:type="dc:Point" y="140.0"/>
                <di:waypoint x="700.0" xsi:type="dc:Point" y="140.0"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
